{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [],
    "paths": {
      "@/*": [
        "../../web/*"
      ],
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "../node_modules/@types/react-dom/*"
      ],
      "lucide-react": [
        "../node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
